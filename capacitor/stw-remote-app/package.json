{
  "name": "stw-remote-app",
  "version": "1.0.0",
  "description": "Capacitor app wrapping the ST2000 Remote ESP32 web UI",
  "type": "module",
  "keywords": [
    "capacitor",
    "mobile",
    "seatalk",
    "autopilot"
  ],
  "scripts": {
    "sync": "node sync-data.mjs",
    "start": "npm run sync && vite",
    "prebuild": "node sync-data.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "build:android": "npm run cap:sync && cd android && ./gradlew :app:assembleDebug && cd .. && node copy-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "latest",
    "@capacitor/ios": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "esbuild": "^0.27.0",
    "vite": "^7.3.1"
  },
  "author": "",
  "license": "ISC"
}
